<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F5F6FA"
             Title="Главная">

    <ScrollView>
        <StackLayout Padding="16" Spacing="0">
            <Label Text="Цифровая точность – здоровая улыбка"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   FontSize="24"
                   Margin="0,20,0,4"
                   TextColor="#244484"/>

            <Label Text="Красивая улыбка – просто"
                   HorizontalOptions="Center"
                   FontSize="14"
                   TextColor="#96A0B5"
                   Margin="0,0,0,16"/>

            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Stroke="#E1E8FF"
                    StrokeThickness="1"
                    Padding="0"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            BackgroundColor="White"
                            StrokeShape="RoundRectangle 12">
                        <Image Source="search.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           BackgroundColor="White"
                           TextColor="#244484"
                           FontSize="15"
                           Placeholder="Поиск услуг..."
                           TextChanged="OnSearchTextChanged"/>
                </Grid>
            </Border>

            <Border Background="White"
                    Stroke="#E1E8FF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Margin="0,-16,0,16"
                    IsVisible="False"
                    x:Name="SearchResultsBorder">
                <ScrollView MaximumHeightRequest="300">
                    <StackLayout x:Name="SearchResultsStack" Spacing="2"/>
                </ScrollView>
            </Border>

            <Label Text="Наша клиника"
                   FontAttributes="Bold"
                   FontSize="22"
                   HorizontalOptions="Center"
                   TextColor="#244484"
                   Margin="0,0,0,16"/>

            <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                <Border Stroke="#C9DEFF" StrokeThickness="2" StrokeShape="RoundRectangle 16"
                        WidthRequest="280" HeightRequest="220" Margin="6">
                    <StackLayout Spacing="0">
                        <Image Source="braces.png" HeightRequest="100" Margin="0,8,0,0"/>
                        <Label Text="Исправление прикуса" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" Margin="0,10,0,2"/>
                        <Button Text="Подробнее" HorizontalOptions="Center" Margin="0,8,0,0" BackgroundColor="#C9DEFF" TextColor="#244484" CornerRadius="10" Padding="18,2" Clicked="OnServicesTapped"/>
                    </StackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServicesTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border Stroke="#C9DEFF" StrokeThickness="2" StrokeShape="RoundRectangle 16"
                        WidthRequest="280" HeightRequest="220" Margin="6">
                    <StackLayout Spacing="0">
                        <Image Source="diagnostics.png" HeightRequest="100" Margin="0,8,0,0"/>
                        <Label Text="Диагностика" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" Margin="0,10,0,2"/>
                        <Button Text="Подробнее" HorizontalOptions="Center" Margin="0,8,0,0" BackgroundColor="#C9DEFF" TextColor="#244484" CornerRadius="10" Padding="18,2" Clicked="OnServicesTapped"/>
                    </StackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServicesTapped"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border Stroke="#C9DEFF" StrokeThickness="2" StrokeShape="RoundRectangle 16"
                        WidthRequest="280" HeightRequest="220" Margin="6">
                    <StackLayout Spacing="0">
                        <Image Source="treatment.png" HeightRequest="100" Margin="0,8,0,0"/>
                        <Label Text="Лечение зубов" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" Margin="0,10,0,2"/>
                        <Button Text="Подробнее" HorizontalOptions="Center" Margin="0,8,0,0" BackgroundColor="#C9DEFF" TextColor="#244484" CornerRadius="10" Padding="18,2" Clicked="OnServicesTapped"/>
                    </StackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServicesTapped"/>
                    </Border.GestureRecognizers>
                </Border>
            </FlexLayout>

            <FlexLayout Wrap="Wrap" JustifyContent="Center" Margin="0,16,0,0">
                <Button Text="Протезирование" BackgroundColor="#EDF5FF" TextColor="#244484" Padding="18,4" Margin="4" FontSize="14" Clicked="OnServicesTapped"/>
                <Button Text="Имплантация" BackgroundColor="#EDF5FF" TextColor="#244484" Padding="18,4" Margin="4" FontSize="14" Clicked="OnServicesTapped"/>
                <Button Text="Отбеливание" BackgroundColor="#EDF5FF" TextColor="#244484" Padding="18,4" Margin="4" FontSize="14" Clicked="OnServicesTapped"/>
                <Button Text="Для детей" BackgroundColor="#EDF5FF" TextColor="#244484" Padding="18,4" Margin="4" FontSize="14" Clicked="OnServicesTapped"/>
            </FlexLayout>

            <StackLayout Margin="0,24,0,16" Spacing="10">
                <Button Text="Записаться на прием" BackgroundColor="#C9FFD9" TextColor="#2AA854" Padding="20,8" CornerRadius="10" FontSize="15" Clicked="OnMakeAppointmentClicked"/>
                <Button Text="Наш адрес" BackgroundColor="#C9DEFF" TextColor="#244484" Padding="20,8" CornerRadius="10" FontSize="15" Clicked="OnAddressClicked"/>
                <Button Text="Яндекс Карты" BackgroundColor="White" TextColor="#E93B26" Padding="20,8" CornerRadius="10" FontSize="15" Clicked="OnMapsClicked"/>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
