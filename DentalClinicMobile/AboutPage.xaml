<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.AboutPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F5F6FA"
             Title="О клинике">

    <ContentPage.Resources>
        <Style x:Key="AboutButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#C9DEFF"/>
            <Setter Property="TextColor" Value="#244484"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="InfoSectionStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            <Setter Property="Stroke" Value="#E1E8FF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="DoctorCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
            <Setter Property="Stroke" Value="#E1E8FF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="WidthRequest" Value="140"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="16" Spacing="0">
            <Label Text="О клинике"
                   FontAttributes="Bold"
                   FontSize="22"
                   TextColor="#244484"
                   Margin="0,0,0,12"/>

            <Border Style="{StaticResource InfoSectionStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Квио - цифровая стоматология"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#244484"/>
                    <Label Text="Мы - современная стоматологическая клиника, которая сочетает в себе передовые технологии, высокий профессионализм и индивидуальный подход к каждому пациенту."
                           TextColor="#828CA0"
                           FontSize="13"/>
                    <Label Text="В работе используем цифровые технологии: внутриротовые сканеры, 3D-диагностику, CAD/CAM системы для максимальной точности результатов."
                           TextColor="#828CA0"
                           FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource InfoSectionStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Наши преимущества"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#244484"/>
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8">
                            <Border WidthRequest="20" HeightRequest="20"
                                    BackgroundColor="#E1E8FF"
                                    StrokeShape="RoundRectangle 5">
                                <Label Text="✓" TextColor="#467EEA" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="10"/>
                            </Border>
                            <Label Text="Цифровая диагностика" TextColor="#244484" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Border WidthRequest="20" HeightRequest="20"
                                    BackgroundColor="#E1E8FF"
                                    StrokeShape="RoundRectangle 5">
                                <Label Text="✓" TextColor="#467EEA" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="10"/>
                            </Border>
                            <Label Text="Современное оборудование" TextColor="#244484" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Border WidthRequest="20" HeightRequest="20"
                                    BackgroundColor="#E1E8FF"
                                    StrokeShape="RoundRectangle 5">
                                <Label Text="✓" TextColor="#467EEA" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="10"/>
                            </Border>
                            <Label Text="Опытные врачи" TextColor="#244484" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Border WidthRequest="20" HeightRequest="20"
                                    BackgroundColor="#E1E8FF"
                                    StrokeShape="RoundRectangle 5">
                                <Label Text="✓" TextColor="#467EEA" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="10"/>
                            </Border>
                            <Label Text="Прозрачные цены" TextColor="#244484" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource InfoSectionStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Наша команда"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#244484"/>
                    <FlexLayout x:Name="DoctorsFlexLayout" Wrap="Wrap" JustifyContent="Center"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource InfoSectionStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Контакты"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="#244484"/>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Адрес" FontAttributes="Bold" FontSize="12" TextColor="#244484"/>
                        <Label Text="ул. Стоматологическая, д. 123" TextColor="#828CA0" FontSize="12"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Телефон" FontAttributes="Bold" FontSize="12" TextColor="#244484"/>
                        <Label Text="+7 (999) 123-45-67" TextColor="#828CA0" FontSize="12"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Режим работы" FontAttributes="Bold" FontSize="12" TextColor="#244484"/>
                        <Label Text="Пн-Пт: 9:00-21:00" TextColor="#828CA0" FontSize="12"/>
                        <Label Text="Сб-Вс: 10:00-18:00" TextColor="#828CA0" FontSize="12"/>
                    </VerticalStackLayout>
                    <Button Text="Записаться"
                            Style="{StaticResource AboutButtonStyle}"
                            Clicked="OnBookAppointmentClicked"/>
                </VerticalStackLayout>
            </Border>
        </StackLayout>
    </ScrollView>
</ContentPage>
