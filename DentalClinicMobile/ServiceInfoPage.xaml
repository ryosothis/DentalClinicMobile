<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.ServiceInfoPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Title="Информация"
             BackgroundColor="#F5F6FA">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="ServiceButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#C9DEFF"/>
            <Setter Property="TextColor" Value="#244484"/>
            <Setter Property="Padding" Value="26,8"/>
            <Setter Property="WidthRequest" Value="280"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="InfoSectionStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="Stroke" Value="#E1E8FF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackLayout Grid.Column="0" 
                     BackgroundColor="#244484"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill">

            <StackLayout Orientation="Horizontal" Margin="18,26,0,16" VerticalOptions="Start">
                <Label Text="Квио" TextColor="White" FontAttributes="Bold" FontSize="26"/>
                <Image Source="logo.png" WidthRequest="32" HeightRequest="32" Margin="10,0,0,0"/>
            </StackLayout>
            <Label Text="цифровая стоматология" TextColor="White" 
                   Margin="18,-20,0,36" FontSize="9"/>

            <StackLayout Margin="18,0,0,0">
                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="home.png" WidthRequest="20" HeightRequest="20" Margin="0,0,10,0"/>
                    <Label Text="Главная" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="info.png" WidthRequest="20" HeightRequest="20" Margin="0,0,10,0"/>
                    <Label Text="О клинике" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAboutTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="services.png" WidthRequest="20" HeightRequest="20" Margin="0,0,10,0"/>
                    <Label Text="Услуги" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServicesTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="price.png" WidthRequest="20" HeightRequest="20" Margin="0,5,10,0"/>
                    <Label Text="Цены" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPriceTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="user.png" WidthRequest="20" HeightRequest="20" Margin="0,0,10,0"/>
                    <Label Text="Профиль" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Margin="18,20,0,20" VerticalOptions="EndAndExpand" Spacing="10">
                <Image Source="vk.png" WidthRequest="20" HeightRequest="20"/>
                <Image Source="whatsapp.png" WidthRequest="20" HeightRequest="20"/>
                <Image Source="tg.png" WidthRequest="20" HeightRequest="20"/>
            </StackLayout>
        </StackLayout>

        <ScrollView Grid.Column="1" BackgroundColor="#F5F6FA">
            <StackLayout Margin="20">
                <ActivityIndicator x:Name="LoadingIndicator" 
                                 IsVisible="False"
                                 IsRunning="False"
                                 Color="#467EEA"
                                 Margin="0,0,0,20"/>

                <StackLayout x:Name="MainContent" IsVisible="True">
                    <Label x:Name="ServiceTitleText" 
                           Text="Информация о лечении" 
                           FontAttributes="Bold" 
                           FontSize="28" 
                           TextColor="#244484" 
                           Margin="0,0,0,10"/>

                    <Label x:Name="ServiceNameText" 
                           Text="Загрузка..." 
                           FontAttributes="Bold" 
                           FontSize="20" 
                           TextColor="#467EEA" 
                           Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <StackLayout Grid.Column="0">
                            <Border Style="{StaticResource InfoSectionStyle}">
                                <VerticalStackLayout>
                                    <Label Text="Описание услуги" 
                                           FontAttributes="Bold" 
                                           FontSize="18" 
                                           TextColor="#244484" 
                                           Margin="0,0,0,15"/>

                                    <Label x:Name="ServiceDescriptionText"
                                           Text="Загрузка описания..."
                                           TextColor="#828CA0" 
                                           FontSize="14"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Style="{StaticResource InfoSectionStyle}">
                                <VerticalStackLayout>
                                    <Label Text="Преимущества" 
                                           FontAttributes="Bold" 
                                           FontSize="18" 
                                           TextColor="#244484" 
                                           Margin="0,0,0,15"/>

                                    <StackLayout x:Name="AdvantagesStackLayout">
                                    </StackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </StackLayout>

                        <StackLayout Grid.Column="2">
                            <Border Style="{StaticResource InfoSectionStyle}">
                                <VerticalStackLayout>
                                    <Label Text="Стоимость услуги" 
                                           FontAttributes="Bold" 
                                           FontSize="18" 
                                           TextColor="#244484" 
                                           Margin="0,0,0,15"/>

                                    <Label x:Name="ServicePriceText"
                                           Text="Загрузка..." 
                                           FontAttributes="Bold" 
                                           FontSize="24" 
                                           TextColor="#467EEA" 
                                           HorizontalOptions="Center"
                                           Margin="0,0,0,10"/>

                                    <Label Text="* Точная стоимость определяется после консультации" 
                                           TextColor="#828CA0" 
                                           FontSize="11"
                                           FontAttributes="Italic"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <Button Text="Записаться на прием" 
                                    Style="{StaticResource ServiceButtonStyle}"
                                    Clicked="OnBookAppointmentClicked"/>
                        </StackLayout>
                    </Grid>
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>