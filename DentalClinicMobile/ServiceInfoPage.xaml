<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.ServiceInfoPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Информация"
             BackgroundColor="#F5F6FA">

    <ContentPage.Resources>
        <Style x:Key="InfoSectionStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="Stroke" Value="#E1E8FF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="16" Spacing="0">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#467EEA"
                               Margin="0,0,0,16"/>

            <StackLayout x:Name="MainContent" IsVisible="True">
                <Label x:Name="ServiceTitleText"
                       Text="Информация о лечении"
                       FontAttributes="Bold"
                       FontSize="22"
                       TextColor="#244484"
                       Margin="0,0,0,6"/>

                <Label x:Name="ServiceNameText"
                       Text="Загрузка..."
                       FontAttributes="Bold"
                       FontSize="18"
                       TextColor="#467EEA"
                       Margin="0,0,0,16"/>

                <Border Style="{StaticResource InfoSectionStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Описание услуги"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#244484"/>
                        <Label x:Name="ServiceDescriptionText"
                               Text="Загрузка описания..."
                               TextColor="#828CA0"
                               FontSize="14"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource InfoSectionStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Преимущества"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#244484"/>
                        <StackLayout x:Name="AdvantagesStackLayout"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource InfoSectionStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Стоимость услуги"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#244484"/>
                        <Label x:Name="ServicePriceText"
                               Text="Загрузка..."
                               FontAttributes="Bold"
                               FontSize="22"
                               TextColor="#467EEA"
                               HorizontalOptions="Center"/>
                        <Label Text="* Точная стоимость определяется после консультации"
                               TextColor="#828CA0"
                               FontSize="11"
                               FontAttributes="Italic"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Записаться на прием"
                        BackgroundColor="#C9DEFF"
                        TextColor="#244484"
                        Padding="20,10"
                        FontSize="16"
                        CornerRadius="10"
                        HorizontalOptions="Fill"
                        Clicked="OnBookAppointmentClicked"/>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
