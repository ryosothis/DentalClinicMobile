<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.PricePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Title="Наши цены"
             BackgroundColor="#F5F6FA">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="PriceBlockStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="Stroke" Value="#C9DEFF"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Padding" Value="18,16,18,24"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackLayout Grid.Column="0" 
                     BackgroundColor="#244484"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill">

            <StackLayout Orientation="Horizontal" Margin="18,26,0,16" VerticalOptions="Start">
                <Label Text="Квио" TextColor="White" FontAttributes="Bold" FontSize="26"/>
                <Image Source="logo.png" WidthRequest="32" HeightRequest="32" Margin="10,0,0,0"/>
            </StackLayout>
            <Label Text="цифровая стоматология" TextColor="White" 
                   Margin="18,-20,0,36" FontSize="9"/>

            <StackLayout Margin="18,0,0,0">
                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="home.png" WidthRequest="20" HeightRequest="20" Margin="0,0,10,0"/>
                    <Label Text="Главная" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="info.png" WidthRequest="20" HeightRequest="20" Margin="0,0,10,0"/>
                    <Label Text="О клинике" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAboutTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="services.png" WidthRequest="20" HeightRequest="20" Margin="0,0,10,0"/>
                    <Label Text="Услуги" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServicesTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="price.png" WidthRequest="20" HeightRequest="20" Margin="0,5,10,0"/>
                    <Label Text="Цены" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPriceTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Margin="0,10,0,0" VerticalOptions="Center">
                    <Image Source="user.png" WidthRequest="20" HeightRequest="20" Margin="0,0,10,0"/>
                    <Label Text="Профиль" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped"/>
                    </StackLayout.GestureRecognizers>
                </StackLayout>
            </StackLayout>

            <StackLayout Orientation="Horizontal" Margin="18,20,0,20" VerticalOptions="EndAndExpand" Spacing="10">
                <Image Source="vk.png" WidthRequest="20" HeightRequest="20"/>
                <Image Source="whatsapp.png" WidthRequest="20" HeightRequest="20"/>
                <Image Source="tg.png" WidthRequest="20" HeightRequest="20"/>
            </StackLayout>
        </StackLayout>

        <ScrollView Grid.Column="1" BackgroundColor="#F5F6FA">
            <StackLayout Margin="20" MinimumWidthRequest="700">
                <Label Text="Цены" 
                       FontAttributes="Bold" 
                       FontSize="32" 
                       TextColor="#244484" 
                       Margin="0,0,0,10"/>

                <Label Text="У нас — честные цены и прозрачные услуги. Вы платите только за то, что нужно для вашей улыбки! Предложим оптимальное решение под ваш бюджет — заботимся о вашем комфорте и экономии."
                       FontSize="14" 
                       Margin="0,0,0,24" 
                       TextColor="#828CA0"
                       MaximumWidthRequest="900"/>

                <ActivityIndicator x:Name="LoadingIndicator" 
                                 IsVisible="False"
                                 IsRunning="False"
                                 Color="#467EEA"
                                 Margin="0,0,0,20"/>

                <StackLayout x:Name="MainContent" IsVisible="True">
                    <Border Style="{StaticResource PriceBlockStyle}">
                        <VerticalStackLayout>
                            <Grid x:Name="ServicesGrid" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Label Text="Услуга" 
                                       FontAttributes="Bold" 
                                       Grid.Row="0" Grid.Column="0" 
                                       FontSize="17" 
                                       Margin="0,0,0,8"
                                       TextColor="#244484"/>
                                <Label Text="Стоимость" 
                                       FontAttributes="Bold" 
                                       Grid.Row="0" Grid.Column="1" 
                                       FontSize="17" 
                                       Margin="0,0,0,8"
                                       TextColor="#244484"/>
                            </Grid>

                            <Button Text="Записаться на консультацию"
                                    HorizontalOptions="Center"
                                    Margin="0,28,0,0"
                                    BackgroundColor="#C9DEFF"
                                    TextColor="#244484"
                                    Padding="26,8"
                                    WidthRequest="320"
                                    FontSize="16"
                                    CornerRadius="10"
                                    Clicked="OnBookAppointmentClicked"/>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Качественная стоматология доступна каждому."
                           TextColor="#828CA0" 
                           FontSize="14" 
                           Margin="0,0,0,10"/>
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>