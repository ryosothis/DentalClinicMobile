<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.PricePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Наши цены"
             BackgroundColor="#F5F6FA">

    <ContentPage.Resources>
        <Style x:Key="PriceBlockStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="Stroke" Value="#C9DEFF"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="16" Spacing="0">
            <Label Text="Цены"
                   FontAttributes="Bold"
                   FontSize="24"
                   TextColor="#244484"
                   Margin="0,0,0,8"/>

            <Label Text="У нас — честные цены и прозрачные услуги. Вы платите только за то, что нужно для вашей улыбки!"
                   FontSize="13"
                   Margin="0,0,0,20"
                   TextColor="#828CA0"/>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#467EEA"
                               Margin="0,0,0,16"/>

            <StackLayout x:Name="MainContent" IsVisible="True">
                <Border Style="{StaticResource PriceBlockStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Grid x:Name="ServicesGrid" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Label Text="Услуга"
                                   FontAttributes="Bold"
                                   Grid.Row="0" Grid.Column="0"
                                   FontSize="15"
                                   TextColor="#244484"/>
                            <Label Text="Стоимость"
                                   FontAttributes="Bold"
                                   Grid.Row="0" Grid.Column="1"
                                   FontSize="15"
                                   TextColor="#244484"/>
                        </Grid>

                        <Button Text="Записаться на консультацию"
                                HorizontalOptions="Center"
                                Margin="0,20,0,0"
                                BackgroundColor="#C9DEFF"
                                TextColor="#244484"
                                Padding="20,8"
                                FontSize="15"
                                CornerRadius="10"
                                Clicked="OnBookAppointmentClicked"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Качественная стоматология доступна каждому."
                       TextColor="#828CA0"
                       FontSize="13"
                       Margin="0,0,0,10"/>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
