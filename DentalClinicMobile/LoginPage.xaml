<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F5F6FA"
             Title="Авторизация">

    <ScrollView>
        <Border Margin="20"
                Padding="24"
                CornerRadius="20"
                BorderColor="#E1E8FF"
                BackgroundColor="White"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label Text="Вход в систему"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#244484"
                       HorizontalOptions="Center"/>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Email" TextColor="#244484" FontAttributes="Bold" FontSize="14"/>
                    <Entry x:Name="EmailEntry"
                           Placeholder="Введите Email"
                           TextColor="#244484"
                           BackgroundColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Пароль" TextColor="#244484" FontAttributes="Bold" FontSize="14"/>
                    <Entry x:Name="PasswordEntry"
                           IsPassword="True"
                           Placeholder="Введите пароль"
                           TextColor="#244484"
                           BackgroundColor="White"/>
                </VerticalStackLayout>

                <HorizontalStackLayout>
                    <CheckBox x:Name="RememberMeCheckBox"/>
                    <Label Text="Запомнить меня" VerticalOptions="Center" TextColor="#244484"/>
                </HorizontalStackLayout>

                <Button Text="Войти"
                        BackgroundColor="#244484"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="48"
                        FontSize="16"
                        Clicked="OnLoginClicked"/>

                <HorizontalStackLayout HorizontalOptions="Center">
                    <Label Text="Нет аккаунта?" TextColor="#828CA0" FontSize="14"/>
                    <Label Text="Зарегистрируйтесь" TextColor="#467EEA" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
