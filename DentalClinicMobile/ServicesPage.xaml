<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.ServicesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Услуги"
             BackgroundColor="#F5F6FA">

    <ContentPage.Resources>
        <Style x:Key="ServiceCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="Stroke" Value="#E1E8FF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="WidthRequest" Value="300"/>
            <Setter Property="HeightRequest" Value="160"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="16" Spacing="0">
            <Label Text="Услуги"
                   FontAttributes="Bold"
                   FontSize="22"
                   TextColor="#244484"
                   Margin="0,0,0,10"/>

            <Label Text="В нашей клинике мы применяем самые современные цифровые технологии для вашего комфорта и безопасности. Мы предлагаем полный спектр стоматологических услуг — от диагностики и профилактики до эстетической стоматологии и протезирования."
                   FontSize="13"
                   Margin="0,0,0,20"
                   TextColor="#828CA0"/>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#467EEA"
                               Margin="0,0,0,16"/>

            <StackLayout x:Name="MainContent" IsVisible="True">
                <FlexLayout x:Name="ServicesFlexLayout"
                            Wrap="Wrap"
                            JustifyContent="Center"
                            AlignItems="Center"
                            Margin="0,4,0,0"/>

                <Button Text="Записаться на консультацию"
                        BackgroundColor="#244484"
                        TextColor="White"
                        FontSize="15"
                        FontAttributes="Bold"
                        Padding="20,10"
                        CornerRadius="10"
                        HorizontalOptions="Center"
                        Margin="0,24,0,0"
                        Clicked="OnAppointmentButtonClicked"/>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
