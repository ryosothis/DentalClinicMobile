<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.RegisterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F5F6FA"
             Title="Регистрация">

    <ScrollView>
        <Border Margin="16"
                Padding="20"
                CornerRadius="20"
                BorderColor="#E1E8FF"
                BackgroundColor="White"
                HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="10">
                <Label Text="Регистрация"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#244484"
                       HorizontalOptions="Center"/>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Имя" TextColor="#244484" FontAttributes="Bold" FontSize="13"/>
                    <Entry x:Name="FirstNameEntry" Placeholder="Введите имя" TextColor="#244484" BackgroundColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Фамилия" TextColor="#244484" FontAttributes="Bold" FontSize="13"/>
                    <Entry x:Name="LastNameEntry" Placeholder="Введите фамилию" TextColor="#244484" BackgroundColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Отчество" TextColor="#244484" FontAttributes="Bold" FontSize="13"/>
                    <Entry x:Name="MiddleNameEntry" Placeholder="Введите отчество" TextColor="#244484" BackgroundColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Телефон" TextColor="#244484" FontAttributes="Bold" FontSize="13"/>
                    <Entry x:Name="PhoneEntry" Keyboard="Telephone" Placeholder="+7" TextColor="#244484" BackgroundColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Email" TextColor="#244484" FontAttributes="Bold" FontSize="13"/>
                    <Entry x:Name="EmailEntry" Keyboard="Email" Placeholder="example@mail.ru" TextColor="#244484" BackgroundColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Дата рождения" TextColor="#244484" FontAttributes="Bold" FontSize="13"/>
                    <DatePicker x:Name="BirthDatePicker" Format="dd.MM.yyyy" BackgroundColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Пароль" TextColor="#244484" FontAttributes="Bold" FontSize="13"/>
                    <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Пароль" TextColor="#244484" BackgroundColor="White"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="3">
                    <Label Text="Подтверждение пароля" TextColor="#244484" FontAttributes="Bold" FontSize="13"/>
                    <Entry x:Name="ConfirmPasswordEntry" IsPassword="True" Placeholder="Повторите пароль" TextColor="#244484" BackgroundColor="White"/>
                </VerticalStackLayout>

                <HorizontalStackLayout>
                    <CheckBox x:Name="AgreementCheckBox"/>
                    <Label Text="Я согласен с условиями использования" VerticalOptions="Center" TextColor="#244484" FontSize="13"/>
                </HorizontalStackLayout>

                <Button x:Name="RegisterButton"
                        Text="Зарегистрироваться"
                        Clicked="OnRegisterClicked"
                        BackgroundColor="#244484"
                        TextColor="White"
                        HeightRequest="48"
                        CornerRadius="12"
                        FontSize="16"/>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label Text="Уже есть аккаунт?" TextColor="#828CA0" VerticalOptions="Center" FontSize="14"/>
                    <Label Text="Войти" TextColor="#467EEA" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoginTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
