<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.DoctorAppointmentsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F5F6FA"
             Title="Записи">

    <ScrollView>
        <StackLayout Padding="16" Spacing="0">
            <Label Text="Мои записи на сегодня"
                   FontAttributes="Bold"
                   FontSize="22"
                   TextColor="#244484"
                   Margin="0,0,0,12"/>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#467EEA"
                               Margin="0,0,0,16"/>

            <Label x:Name="DateLabel"
                   Text="Загрузка..."
                   FontSize="15"
                   TextColor="#828CA0"
                   Margin="0,0,0,16"/>

            <StackLayout x:Name="AppointmentsStackLayout"/>

            <Label x:Name="NoAppointmentsLabel"
                   Text="На сегодня записей нет"
                   FontSize="15"
                   TextColor="#828CA0"
                   HorizontalOptions="Center"
                   Margin="0,40,0,0"
                   IsVisible="False"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
