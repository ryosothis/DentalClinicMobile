<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.AppointmentPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F5F6FA"
             Title="Запись на прием">

    <ContentPage.Resources>
        <Style x:Key="SelectionCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
            <Setter Property="Stroke" Value="#E1E8FF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
            <Setter Property="Stroke" Value="#E1E8FF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="16" Spacing="0">
            <Label Text="Оформление записи на прием"
                   FontAttributes="Bold"
                   FontSize="22"
                   TextColor="#244484"
                   Margin="0,0,0,16"/>

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#467EEA"
                               Margin="0,0,0,16"/>

            <StackLayout x:Name="MainContent" IsVisible="True" Spacing="0">
                <Border Style="{StaticResource SectionStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Выбор услуги"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#244484"/>
                        <StackLayout x:Name="ServicesStackLayout"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Выбор врача"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#244484"/>
                        <StackLayout x:Name="DoctorsStackLayout"/>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Выбор даты и времени"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#244484"/>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Дата приема"
                                   TextColor="#828CA0"
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                            <DatePicker x:Name="AppointmentDatePicker"
                                        Format="dd.MM.yyyy"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Время приема"
                                   TextColor="#828CA0"
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                            <Picker x:Name="TimePicker" Title="Выберите время">
                                <Picker.Items>
                                    <x:String>09:00</x:String>
                                    <x:String>10:00</x:String>
                                    <x:String>11:00</x:String>
                                    <x:String>12:00</x:String>
                                    <x:String>14:00</x:String>
                                    <x:String>15:00</x:String>
                                    <x:String>16:00</x:String>
                                    <x:String>17:00</x:String>
                                </Picker.Items>
                            </Picker>
                        </VerticalStackLayout>

                        <Border BackgroundColor="#F8FBFF"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#E1E8FF"
                                StrokeThickness="1"
                                Padding="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Информация о записи"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="#244484"/>

                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="Услуга:"
                                           TextColor="#828CA0"
                                           FontSize="11"/>
                                    <Label x:Name="SelectedServiceText"
                                           Grid.Row="0" Grid.Column="1"
                                           Text="Не выбрана"
                                           FontAttributes="Bold"
                                           FontSize="11"
                                           TextColor="#244484"
                                           Margin="8,0,0,0"/>

                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="Врач:"
                                           TextColor="#828CA0"
                                           FontSize="11"/>
                                    <Label x:Name="SelectedDoctorText"
                                           Grid.Row="1" Grid.Column="1"
                                           Text="Не выбран"
                                           FontAttributes="Bold"
                                           FontSize="11"
                                           TextColor="#244484"
                                           Margin="8,0,0,0"/>

                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="Стоимость:"
                                           TextColor="#828CA0"
                                           FontSize="11"/>
                                    <Label x:Name="SelectedPriceText"
                                           Grid.Row="2" Grid.Column="1"
                                           Text="0 ₽"
                                           FontAttributes="Bold"
                                           FontSize="11"
                                           TextColor="#467EEA"
                                           Margin="8,0,0,0"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Записаться на прием"
                        BackgroundColor="#C9DEFF"
                        TextColor="#244484"
                        Padding="20,10"
                        CornerRadius="10"
                        FontSize="16"
                        HorizontalOptions="Fill"
                        Margin="0,8,0,16"
                        Clicked="OnConfirmAppointmentClicked"/>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
