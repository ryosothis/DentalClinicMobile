<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DentalClinicMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DentalClinicMobile"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#244484"
    TitleColor="White">

    <Shell.FlyoutHeader>
        <StackLayout Padding="20" Spacing="4">
            <Label Text="Квио" TextColor="White" FontAttributes="Bold" FontSize="26"/>
            <Label Text="цифровая стоматология" TextColor="#C9DEFF" FontSize="11"/>
        </StackLayout>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Главная" Icon="home.png">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage"/>
    </FlyoutItem>

    <FlyoutItem Title="О клинике" Icon="info.png">
        <ShellContent ContentTemplate="{DataTemplate local:AboutPage}" Route="AboutPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Услуги" Icon="services.png">
        <ShellContent ContentTemplate="{DataTemplate local:ServicesPage}" Route="ServicesPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Цены" Icon="price.png">
        <ShellContent ContentTemplate="{DataTemplate local:PricePage}" Route="PricePage"/>
    </FlyoutItem>

    <FlyoutItem Title="Профиль" Icon="user.png">
        <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" Route="ProfilePage"/>
    </FlyoutItem>

</Shell>
