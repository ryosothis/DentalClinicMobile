<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="DentalClinicMobile.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="#F5F6FA"
             Title="Профиль">

    <ScrollView>
        <StackLayout Padding="16" Spacing="0">
            <ActivityIndicator x:Name="ProgressBar"
                               HeightRequest="4"
                               Margin="0,0,0,8"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#467EEA"/>

            <HorizontalStackLayout x:Name="RoleButtonsPanel"
                                   HorizontalOptions="End"
                                   Spacing="8"
                                   IsVisible="False">
                <Button x:Name="AdminPanelButton"
                        Text="Админ-панель"
                        BackgroundColor="#244484"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="12,6"
                        FontSize="13"
                        Clicked="OnAdminPanelClicked"
                        IsVisible="False"/>
                <Button x:Name="DoctorAppointmentsButton"
                        Text="Мои записи"
                        BackgroundColor="#244484"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="12,6"
                        FontSize="13"
                        Clicked="OnDoctorAppointmentsClicked"
                        IsVisible="False"/>
                <Button x:Name="LogoutButton"
                        Text="Выйти"
                        BackgroundColor="Transparent"
                        TextColor="#FF6B6B"
                        BorderColor="#FF6B6B"
                        BorderWidth="1"
                        CornerRadius="8"
                        Padding="12,6"
                        FontSize="13"
                        Clicked="OnLogoutClicked"/>
            </HorizontalStackLayout>

            <StackLayout x:Name="MainContent" Spacing="16">
                <Label Text="Профиль"
                       FontAttributes="Bold"
                       FontSize="22"
                       TextColor="#244484"/>

                <Label x:Name="RoleTextBlock"
                       Text="Роль: Загрузка..."
                       FontSize="13"
                       TextColor="#828CA0"
                       FontAttributes="Bold"/>

                <Border BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E1E8FF"
                        StrokeThickness="1"
                        Padding="16">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                            <Border WidthRequest="80" HeightRequest="80"
                                    BackgroundColor="#E1E8FF"
                                    StrokeShape="RoundRectangle 40"
                                    Stroke="#C9DEFF"
                                    StrokeThickness="3"
                                    HorizontalOptions="Center">
                                <Image Source="avatar.png"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Grid>
                                <Entry x:Name="FullNameTextBox"
                                       Text="Загрузка..."
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalTextAlignment="Center"
                                       BackgroundColor="Transparent"
                                       TextColor="#244484"
                                       IsReadOnly="True"/>
                                <Button x:Name="EditNameButton"
                                        BackgroundColor="Transparent"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Clicked="OnEditNameClicked">
                                    <Button.ImageSource>
                                        <FileImageSource File="edit.png"/>
                                    </Button.ImageSource>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Дата рождения"
                                   TextColor="#828CA0"
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                            <Grid>
                                <Entry x:Name="BirthDateTextBox"
                                       Text="Загрузка..."
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       BackgroundColor="Transparent"
                                       TextColor="#244484"
                                       IsReadOnly="True"/>
                                <Button x:Name="EditBirthDateButton"
                                        BackgroundColor="Transparent"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Clicked="OnEditBirthDateClicked">
                                    <Button.ImageSource>
                                        <FileImageSource File="edit.png"/>
                                    </Button.ImageSource>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView Color="#E1E8FF" HeightRequest="1" Margin="0,4"/>

                        <Label Text="Контактная информация"
                               TextColor="#244484"
                               FontSize="14"
                               FontAttributes="Bold"/>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Email"
                                   TextColor="#828CA0"
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                            <Grid>
                                <Entry x:Name="EmailTextBox"
                                       Text="Загрузка..."
                                       FontSize="14"
                                       BackgroundColor="Transparent"
                                       TextColor="#244484"
                                       IsReadOnly="True"/>
                                <Button x:Name="EditEmailButton"
                                        BackgroundColor="Transparent"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Clicked="OnEditEmailClicked">
                                    <Button.ImageSource>
                                        <FileImageSource File="edit.png"/>
                                    </Button.ImageSource>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Телефон"
                                   TextColor="#828CA0"
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                            <Grid>
                                <Entry x:Name="PhoneTextBox"
                                       Text="Загрузка..."
                                       FontSize="14"
                                       BackgroundColor="Transparent"
                                       TextColor="#244484"
                                       IsReadOnly="True"/>
                                <Button x:Name="EditPhoneButton"
                                        BackgroundColor="Transparent"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        Margin="0,0,4,0"
                                        Clicked="OnEditPhoneClicked">
                                    <Button.ImageSource>
                                        <FileImageSource File="edit.png"/>
                                    </Button.ImageSource>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#E1E8FF"
                        StrokeThickness="1"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="История записей"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#244484"/>
                        <StackLayout x:Name="MedicalHistoryStackLayout"/>
                    </VerticalStackLayout>
                </Border>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
